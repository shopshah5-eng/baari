# ── Baari ─────────────────────────────────────────────────────────────
PORT=3000

# Gemini 2.5 Flash — leave blank to run the deterministic mock (no key needed)
GEMINI_API_KEY=

# WhatsApp lane for NEW tenants: mock | baileys | meta
WA_LANE=mock

# Baileys per-tenant session root (one encrypted auth dir per org)
WA_SESSIONS_DIR=./data/sessions

# Public base URL — used in WhatsApp deep links (status page, review redirect)
PUBLIC_URL=http://localhost:3000

# Razorpay (billing) — optional in v0
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Supabase — v0 uses data/db.json; set these to switch to Postgres (see docs/05)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
