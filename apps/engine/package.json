{
  "name": "baari",
  "version": "0.9.0",
  "private": true,
  "description": "Baari - WhatsApp-first front office for clinics, labs & salons (India)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node src/server.js",
    "seed": "node src/seed.js",
    "reset": "rm -f data/db.json && node src/seed.js",
    "test": "node src/test.js",
    "test:sql": "node src/sql/test-sql.js",
    "test:all": "node src/test.js && node src/sql/test-sql.js",
    "migrate": "node scripts/migrate.js",
    "assets": "node scripts/make-assets.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "express": "^4.19.2",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "pg-mem": "^3.0.14",
    "qrcode": "^1.5.4"
  }
}