{
  "name": "baari-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test": "npm --prefix apps/engine test",
    "test:sql": "npm --prefix apps/engine run test:sql",
    "test:all": "npm --prefix apps/engine run test:all",
    "gate:0": "node scripts/gate.js 0",
    "gate:1": "node scripts/gate.js 1",
    "gate:2": "node scripts/gate.js 2",
    "gate:3": "node scripts/gate.js 3",
    "gate:4": "node scripts/gate.js 4",
    "gate:5": "node scripts/gate.js 5",
    "gate:6": "node scripts/gate.js 6",
    "gate:7": "node scripts/gate.js 7",
    "accept": "node scripts/accept.js",
    "dev:engine": "npm --prefix apps/engine run dev",
    "dev:web": "npm --prefix apps/web run dev",
    "dev": "concurrently \"npm run dev:engine\" \"npm run dev:web\"",
    "build": "npm --prefix packages/shared run build && npm --prefix apps/web run build"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}

